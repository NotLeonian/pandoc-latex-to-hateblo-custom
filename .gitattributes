* text=auto eol=lf

# Common binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.jar   binary
*.war   binary
*.class binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Markdown
*.md    text diff=markdown whitespace=-blank-at-eol
*.mdx   text diff=markdown whitespace=-blank-at-eol

# C, C++
*.c     text diff=cpp
*.cc    text diff=cpp
*.cpp   text diff=cpp
*.cxx   text diff=cpp
*.h     text diff=cpp
*.hh    text diff=cpp
*.hpp   text diff=cpp
*.hxx   text diff=cpp
*.ipp   text diff=cpp
*.tpp   text diff=cpp
*.ixx   text diff=cpp
*.cppm  text diff=cpp

# Python
*.py    text diff=python
*.pyi   text diff=python
*.pyw   text diff=python

# Generated Python binary files
*.pyc   binary
*.pyo   binary
*.pyd   binary

# Shell
*.sh    text diff=bash

# HTML
*.html  text diff=html

# LaTeX, BibTeX, LyX
*.tex   text diff=tex
*.bib   text diff=bibtex
*.lyx   text whitespace=-blank-at-eol

# Configuration and lock files
*.ini   text
*.toml  text
*.lock  text

# License text
*.MIT   text

# Vendored files
_vendor/** linguist-vendored -text -eol

# Generated files
example/*.html    linguist-generated -text -eol whitespace=-blank-at-eol
example/**/*.html linguist-generated -text -eol whitespace=-blank-at-eol
